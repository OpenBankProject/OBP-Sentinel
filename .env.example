# --- OBP-API connection -------------------------------------------------------
# Sentinel calls OBP-API as a Platform App, with its own application token (OAuth2 client
# credentials), not as a User. OBP-OIDC creates the client "obp-sentinel" at startup; copy its
# client id and secret here. An administrator marks its Consumer as a Platform App and grants the
# Scopes Sentinel declares (see README.md).
OBP_BASE_URL=http://localhost:8080
OIDC_ISSUER=http://localhost:9000/obp-oidc
OIDC_CLIENT_ID=change-me
OIDC_CLIENT_SECRET=change-me

# API versions that serve the endpoints Sentinel reads
OBP_LOG_CACHE_API_VERSION=v5.1.0
OBP_TELEMETRY_API_VERSION=v7.0.0
OBP_AGGREGATE_METRICS_API_VERSION=v6.0.0

# --- Source code the analyst reads --------------------------------------------
OBP_API_SOURCE=/home/you/workspace/OBP-API

# --- Collector ------------------------------------------------------------------
SENTINEL_DB=sentinel.db
SENTINEL_POLL_SECONDS=120
# Comma separated: error,warning,info,debug,trace
SENTINEL_LOG_LEVELS=error,warning
# Entries fetched per level per poll (OBP keeps 1000 per level by default)
SENTINEL_FETCH_LIMIT=1000
SENTINEL_BUCKET_MINUTES=15
# Telemetry meters stored, by name prefix
SENTINEL_TELEMETRY_PREFIXES=obp.api.,hikaricp.connections,jvm.memory.used,jvm.gc.pause
# Log lines matching this regex are ignored (Sentinel's own calls)
SENTINEL_IGNORE_REGEX=system/log-cache|management/telemetry|management/aggregate-metrics|consumers/current/platform-app
SENTINEL_RETENTION_DAYS=14

# --- Digest: keeps Sentinel from overwhelming people ---------------------------------
# Hours of watching required before a digest can be written
SENTINEL_MIN_WATCH_HOURS=4
# Most suggestions in one digest, and in any 7 days
SENTINEL_DIGEST_SIZE=3
SENTINEL_MAX_PER_WEEK=10
# Findings scoring below this are never suggested
SENTINEL_MIN_PRIORITY=1.0
# Days a "later" finding stays quiet
SENTINEL_SNOOZE_DAYS=7

# --- Web page (sentinel ui) -------------------------------------------------------
# No login: keep it on 127.0.0.1 unless it sits behind something that authenticates
SENTINEL_UI_HOST=127.0.0.1
SENTINEL_UI_PORT=8765

# --- Analyst (headless Claude Code) --------------------------------------------------
# Runs at startup of run/collect/ui, then every this many minutes if something is new. 0 turns it off.
SENTINEL_ANALYSE_MINUTES=60
# Hours watched (in the last 6h) before the analyst runs at all
SENTINEL_ANALYSE_MIN_WATCH_HOURS=2
# Most one run may spend, and how long it may take
SENTINEL_ANALYSE_BUDGET_USD=2
SENTINEL_ANALYSE_TIMEOUT_MINUTES=30
SENTINEL_CLAUDE_COMMAND=claude
